{
  "name": "bellingham-events-aggregator",
  "private": true,
  "version": "0.1.0",
  "description": "Aggregates upcoming Bellingham, WA events from multiple sources into a dashboard and a daily email digest.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "aggregate:local": "tsx scripts/run-aggregate-local.ts",
    "digest:local": "tsx scripts/run-digest-local.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "kv:create": "wrangler kv namespace create EVENTS_KV",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^4.5.0",
    "ical.js": "^2.1.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
